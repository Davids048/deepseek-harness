{
  "name": "@video-harness/bundle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The video-harness profile layer: the DreamVerse generation client, the harness runtime, tools, agent, views, and page plugins, the directing skills, and the model routes, stacked on dsh-base and dsh-web-app or dsh-headless.",
  "exports": {
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@dreamverse/generation-client": "workspace:*",
    "@video-harness/agent": "workspace:*",
    "@video-harness/assets": "workspace:*",
    "@video-harness/media": "workspace:*",
    "@video-harness/mentions": "workspace:*",
    "@video-harness/oplog": "workspace:*",
    "@video-harness/runtime": "workspace:*",
    "@video-harness/tools": "workspace:*",
    "@video-harness/ui-canvas": "workspace:*",
    "@video-harness/ui-composer": "workspace:*",
    "@video-harness/ui-timeline": "workspace:*",
    "@video-harness/ui-tool": "workspace:*",
    "@video-harness/ui-assets": "workspace:*",
    "@video-harness/ui-shell": "workspace:*",
    "@video-harness/views": "workspace:*"
  }
}
