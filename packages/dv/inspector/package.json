{
  "name": "@dv/inspector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Inspector component of DreamVerse: read-only analysis of assets, with inspect.image (the default model answers a question about an image) and inspect.asset (ffprobe metadata).",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@deepseek-ai/dsh-agent-default-model": "workspace:*",
    "@deepseek-ai/dsh-attachment": "workspace:*",
    "@deepseek-ai/dsh-llm": "workspace:*",
    "@dv/asset-pool": "workspace:*",
    "@dv/ffmpeg": "workspace:*",
    "@dv/project": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/cordis-plugin-include": "workspace:~",
    "@deepseek-ai/cordis-plugin-loader": "workspace:~",
    "@deepseek-ai/dsh-brand": "workspace:*",
    "@deepseek-ai/dsh-system-prompt": "workspace:*",
    "@deepseek-ai/dsh-tools": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~",
    "@types/node": "^22.20.0"
  }
}
