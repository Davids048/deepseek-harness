{
  "name": "@dv/deliver",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Deliver component of DreamVerse: deliver.timeline_export trims the clips of a timeline that have an in or out point and joins all clips into one video with ffmpeg.",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@dv/asset-pool": "workspace:*",
    "@dv/ffmpeg": "workspace:*",
    "@dv/project": "workspace:*",
    "@dv/timeline": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/cordis-plugin-include": "workspace:~",
    "@deepseek-ai/cordis-plugin-loader": "workspace:~",
    "@deepseek-ai/dsh-brand": "workspace:*",
    "@deepseek-ai/dsh-llm": "workspace:*",
    "@deepseek-ai/dsh-system-prompt": "workspace:*",
    "@deepseek-ai/dsh-tools": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~",
    "@types/node": "^22.20.0"
  }
}
